<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Husbandry (docs/husbandry.md): hitching posts that keep assigned animals in a pen, and breeding. Its records are added at load from the game's
    own (data phase); Husbandry.mod is empty. Built against the game's assemblies, never copied: the game loads them.
  -->

  <PropertyGroup>
    <AssemblyName>Husbandry</AssemblyName>
    <RootNamespace>Husbandry</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Core/Meitou.Core.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Data/Meitou.Data.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Simulation/Meitou.Simulation.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Game/Meitou.Game.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Husbandry.Tests" />
    <EmbeddedResource Include="Locale/*.json" LogicalName="Husbandry.Locale.%(Filename).json" WithCulture="false" />
    <None Include="meitou.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
